# 该文件仅提供环境变量示例，不要填写或提交真实密码、密钥
# 程序实际读取 .env；未配置的变量会使用代码中的默认值

# 验证码配置，预留给后续验证码模块，当前尚未生效
# 可选值：disable、turnstile、recaptcha、hcaptcha
CAPTCHA_DEV_PASSCODE=replace_with_dev_passcode
CAPTCHA_PROVIDER=disable
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_URL=

# 数据库配置，当前已生效
# 可选值：sqlite、postgres
DB_DRIVER=sqlite
# SQLite 模式使用该文件路径
DB_SQLITE_PATH=./data/blog.db
# PostgreSQL 模式使用以下配置
DB_NAME=my_blog
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_SSL_MODE=disable

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 邮件配置，预留给后续邮件模块，当前尚未生效
EMAIL_ENABLE=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_ADDRESS=
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SSL=true
ENABLE_EMAIL_VERIFY=true

# 应用配置
# 注册、日志、请求体限制和运行模式为后续模块预留，当前尚未生效
DOMAIN=blog.example.com
ENABLE_REGISTER=true
SEED_DEMO_CONTENT=false
ROOT_ADMIN_USERNAME=root
ROOT_ADMIN_EMAIL=root@example.com
ROOT_ADMIN_PASSWORD=
LOG_LEVEL=info
BASE_URL=http://localhost:3000
MAX_REQUEST_BODY_SIZE=1000000
MODE=dev
# HTTP 服务端口，当前已生效
PORT=8888
SHUTDOWN_TIMEOUT_SECONDS=30
TRUSTED_PROXY_CIDRS=
# 当前密码使用 bcrypt 自动生成 salt，该变量暂未使用
PASSWORD_SALT=replace_with_at_least_16_random_chars
# JWT 和 Token 配置，预留给后续认证模块，当前尚未生效
JWT_SECRET=replace_with_at_least_32_random_chars
TOKEN_DURATION=3600
REFRESH_TOKEN_DURATION=604800
REFRESH_TOKEN_DURATION_WITH_REMEMBER=2592000
# 评论、RSS 和 Sitemap 配置，预留给后续业务模块
MAX_REPLY_DEPTH=3
RSS_LIMIT=30
SITEMAP_LIMIT=5000

# 文件存储配置，预留给后续存储模块，当前尚未生效
# 可选驱动由后续实现决定，例如 local、s3、webdav
FILE_DRIVER_TYPE=local
FILE_BASEPATH=./data/uploads
FILE_WEBDAV_URL=
FILE_WEBDAV_USER=
FILE_WEBDAV_PASSWORD=
FILE_WEBDAV_POLICY=

# 文件缓存配置，预留给后续缓存模块，当前尚未生效
MAX_CACHE_FILE=100
